{
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu24.04",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "clangd.path": "/usr/bin/clangd"
      }
    }
  },
  "postCreateCommand": "sudo apt update && sudo apt install -y clangd"
}